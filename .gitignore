# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.kiro/
# secrets and data dumps that must never be committed
*.key
*.p12
*.pfx
id_rsa*
*service-account*.json
*serviceaccount*.json
*credentials*.json
*backup*.json
*backup*.csv
*dump*.json
*dump*.sql

# private security notes (contain exposure details; keep out of public repos until credentials are rotated)
*.local.md
