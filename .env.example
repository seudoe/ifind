# Copy to .env.local and fill in. Never commit real values.
# Everything below is SERVER-ONLY unless it starts with NEXT_PUBLIC_ (those are shipped to browsers
# and must never hold a secret).

# ── Database ────────────────────────────────────────────────────────────────
# Use a least-privilege Atlas user (readWrite on the ifind database only) and an IP/network allowlist.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ifind?retryWrites=true&w=majority

# ── Session signing keys (>= 32 random chars each, all different) ───────────
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
MOD_JWT_SECRET=
EMP_JWT_SECRET=

# ── Public site URL (not secret) ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
MAX_WAIT_FOR_HF=

# ── LinkedIn OAuth ──────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; defaults to <origin>/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=

# ── ImageKit ────────────────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ── Email (Brevo): critical notifications are emailed as well as stored ─────
# Without BREVO_API_KEY + BREVO_SENDER_EMAIL nothing is emailed; notifications still appear in the inbox.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=iFind
# BREVO_SANDBOX=true     Brevo accepts the request but does not deliver (safe for testing)
# EMAIL_DISABLED=true    never send (e.g. preview deployments)

# ── Companion services (base URLs, no trailing slash) ───────────────────────
INTERNSCRAPER_URL=
INTERNSCRAPER_API_KEY=
VECTORISER_URL=
RESUME_EXTRACTOR_URL=

# ── Tooling only (scripts/push-repo-secrets.mjs); not used by the app at runtime
# GH_TOKEN=

# Hosts the Cloudflare proxy may report in x-public-host (comma separated)
TRUSTED_PUBLIC_HOSTS=
